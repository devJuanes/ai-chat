# MatuDB
MATUDB_URL=https://db.matudb.com
MATUDB_PROJECT_ID=your-project-id
MATUDB_API_KEY=anon_or_service_key
MATUDB_SERVICE_KEY=service_key
MATUDB_SCHEMA=main

# Upstream model runtime (server-only — never expose to the client)
UPSTREAM_API_KEY=
UPSTREAM_BASE_URL=https://api.minimax.io/v1
UPSTREAM_MODEL=MiniMax-M3
# Generación de imágenes en chat (mismo API key MiniMax)
UPSTREAM_IMAGE_MODEL=image-01

# MoneyPrinterTurbo — Imagine (generación de videos)
# LOCAL: solo hace falta la URL de la API (python main.py → puerto 8080).
# api_key de MoneyPrinterTurbo suele ir vacía en local → NO pongas MONEYPRINTER_API_KEY.
MONEYPRINTER_BASE_URL=http://127.0.0.1:8080
# LOCAL: déjalo vacío (los videos se sirven desde BASE_URL).
# PRODUCCIÓN: URL pública del generador, ej. https://video.tudominio.com
MONEYPRINTER_PUBLIC_URL=
# LOCAL: vacío. Solo rellénalo si en config.toml de MoneyPrinterTurbo pusiste api_key = "algo"
MONEYPRINTER_API_KEY=

# Server
PUBLIC_APP_URL=https://ai.matubyte.com
# Host público de apps publicadas (/sites/:slug)
PUBLIC_SITES_HOST=https://ai.matubyte.com


# Vite (prefix VITE_ for browser)
VITE_MATUDB_URL=https://db.matudb.com
VITE_MATUDB_PROJECT_ID=your-project-id
VITE_MATUDB_API_KEY=anon_or_service_key
VITE_MATUDB_SCHEMA=main
VITE_COMPANY_NAME=Matu AI SaaS
VITE_COMPANY_URL=https://matubyte.com
VITE_SITE_URL=https://matubyte.com
# Vacío en producción detrás de nginx (mismo origen ai.matubyte.com).
# Solo rellena si el API está en otro host (ej. Firebase + API en VPS).
VITE_API_URL=
# Google Analytics 4 — pega tu Measurement ID (G-XXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Sizor SSO / iframe embed
# Local: URL donde corre Sizor (suele ser otro puerto si MatuAI usa 5173)
VITE_SIZOR_URL=https://sizor.online

# Meta — WhatsApp / Messenger / Instagram (server-only)
# Crea una App en https://developers.facebook.com (tipo Business)
META_APP_ID=
META_APP_SECRET=
# Token arbitrario que configurarás igual en el webhook de Meta
META_VERIFY_TOKEN=matu_meta_verify_change_me
META_API_VERSION=v21.0
# Config ID de WhatsApp Embedded Signup (App → WhatsApp → Configuration)
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Clave para cifrar tokens en DB: 64 hex (32 bytes) o cualquier passphrase
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
META_TOKEN_ENCRYPTION_KEY=

# Migrations MatuDB (consola SQL), en orden:
# docs/migrations/meta-bots.sql
# docs/migrations/meta-bots-v2-leads.sql
# docs/migrations/meta-bots-v3-commerce.sql
# docs/migrations/meta-bots-v3b-catalog-flags.sql
